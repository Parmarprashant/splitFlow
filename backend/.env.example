# Server
PORT=5000
NODE_ENV=development

# MongoDB Database
# Local: mongodb://localhost:27017/splitflow_db
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/splitflow_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/splitflow_db

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d
